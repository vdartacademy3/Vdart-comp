# =================================================================
# VDart Companion (VCamp) - Environment Configuration Template
# =================================================================

# 1. AI Provider Credentials (never commit real keys!)
VCAMP_AI_PROVIDER=groq
VCAMP_AI_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# 2. Backend Security & Privacy Settings
# Set a strong random secret in server/enterprise deployments:
VCAMP_JWT_SECRET=
VCAMP_HR_MIN_GROUP_SIZE=3
VCAMP_ENABLE_DEMO_ACCOUNTS=0
VCAMP_DEMO_ADMIN_PASSWORD=
VCAMP_DEMO_USER_PASSWORD=

# 3. Database & Local Data Path
# Leave empty to use %APPDATA%\VCamp\data on Windows or backend/ in dev
VCAMP_DATA_DIR=
DATABASE_URL=

# 4. Desktop Preferences
VCAMP_DEFAULT_LANGUAGE=auto
VCAMP_AUTO_SPEAK=true
VCAMP_SPEECH_RATE=1.0
VCAMP_SPEECH_PITCH=1.0
