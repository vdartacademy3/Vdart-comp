# =================================================================
# VCamp Desktop Companion & AI Platform - Environment Configuration
# =================================================================

# 1. Groq Cloud AI Inference Credentials
# Obtain free from: https://console.groq.com/keys
# Never commit a real key. Set it in your local .env (git-ignored) before starting the backend.
GROQ_API_KEY=

# 2. Conversational Model Selection
# Recommended choices:
# - llama-3.3-70b-versatile (Default: Multilingual Tamil + English)
# - llama-3.1-8b-instant (Ultra-low-latency)
# - mixtral-8x7b-32768 (High-context reasoning)
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Audio Transcription Engine
# Speech-to-Text via Groq Whisper API
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# 4. Desktop Window Preferences
VCAMP_WINDOW_WIDTH=380
VCAMP_WINDOW_HEIGHT=520
VCAMP_ALWAYS_ON_TOP=true
VCAMP_TRANSPARENT_WINDOW=true

# 5. Language & Speech Preferences
# Supported: auto | ta | en | tanglish
VCAMP_DEFAULT_LANGUAGE=auto
VCAMP_AUTO_SPEAK=true
VCAMP_SPEECH_RATE=1.0
VCAMP_SPEECH_PITCH=1.0
